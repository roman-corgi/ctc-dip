<channels
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="https://raw.githubusercontent.com/roman-corgi/ctc-dip/refs/heads/main/schema/categorization.xsd">
  <cal_a/><!-- not defined in the categorization spec -->
  <cal_absflux>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_ABSFLUX_FAINT</value>
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
  </cal_absflux>
  <cal_badpixelmap/><!-- deprecated: only produced within the flat field recipe -->
  <cal_boresight>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_BORESIGHT</value>
    </operand>
  </cal_boresight>
  <cal_corethpt>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_CORETHRPT</value>
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
  </cal_corethpt>
  <cal_darkpc/> <!-- deprecated: manual processing only -->
  <cal_darksynth/> <!-- deprecated: derived during L2a to L2b -->
  <cal_darktrad/> <!-- deprecated: manual processing only -->
  <cal_flatfield><!-- IMAGING and POL flats share this channel; the DRP selects
                      the recipe from DPAMNAME. CGIVST_CAL_FLAT has no
                      acquisition, so no FRMTYPE filter is needed. -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_FLAT</value>
    </operand>
  </cal_flatfield>
  <cal_dispersionmodel>
    <operand keyword="VISTYPE" operator="equals-any">
      <!--  <value>CGIVST_CAL_SPEC_TGTREF</value>  -->
      <value>PAUSED_FOR_REVIEW</value>
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FPAMNAME" operator="contains-any">
      <value>OPEN</value>
    </operand>
    <operator>and</operator>
  </cal_dispersionmodel>
  <cal_linespread>
    <operand keyword="VISTYPE" operator="equals-any">
      <!--  <value>CGIVST_CAL_SPEC_LINESPREAD</value>  -->
      <value>PAUSED_FOR_REVIEW</value>
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
  </cal_linespread>
  <cal_ndfiltimg/><!-- deactivated: requires an ensemble rule spanning
                       CGIVST_CAL_ABSFLUX_BRIGHT and CGIVST_CAL_ABSFLUX_FAINT,
                       which categorization cannot express. Manual only. -->
  <cal_ndfiltspec/><!-- deactivated pending review -->
  <cal_wlzeropoint>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>PAUSED_FOR_REVIEW</value>
      <!--  <value>CGIVST_CAL_ABSFLUX_FAINT</value>
      <value>CGIVST_CAL_ABSFLUX_BRIGHT</value>  -->
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>PRISM2</value>
      <value>PRISM3</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FPAMNAME" not="true" operator="contains-any">
      <value>ND</value>
    </operand>
    <operator>and</operator>
  </cal_wlzeropoint>
  <cal_polff/><!-- deactivated: polarimetric flats are selected by cal_flatfield
                   so that a CGIVST_CAL_FLAT frame cannot match two channels -->
  <cal_muellermatrix>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_POL_SETUP</value>
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
  </cal_muellermatrix>
  <cal_pupil>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_PUPIL_IMAGING</value>
    </operand>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
    </operand>
    <operator>and</operator>
  </cal_pupil>
  <eng_a><!-- excluding CONT keeps HOWFSC science frames in nfov_a/wfov_a and
             SATSPOTS=False keeps science sat spot frames out; the remaining
             FRMTYPEs entering here are NUM and GITL -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_ENG_OTA_WVFRNT</value>
      <value>CGIVST_ENG_PFAC</value>
      <value>CGIVST_ENG_PUPILCAL</value>
      <value>CGIVST_ENG_IMAGECAL</value>
      <value>CGIVST_ENG_GENERIC_RASTER</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
      <value>CGIVST_UTI_GENERIC_STAR</value>
      <value>CGIVST_UTI_POINT_REFINE</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
      <value>PUPIL</value>
      <value>DEFOCUS1</value>
      <value>DEFOCUS2</value>
      <value>DEFOCUS3</value>
      <value>DEFOCUS4</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
      <value>SPBAL-FPAM</value>
      <value>SPBAL-FSAM</value>
      <value>CONT</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SATSPOTS" operator="equals-any">
      <value>False</value>
    </operand>
    <operator>and</operator>
  </eng_a>
  <nfov_a><!-- "science" coronagraphic frames or "science sat spot" frames -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
    </operand>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>OPEN</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
    </operand>
    <operand keyword="SATSPOTS" operator="equals-any">
      <value>True</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>OPEN</value>
    </operand>
    <operator>and</operator>
    <operator>or</operator>
  </nfov_a>
  <nfov_nc><!-- CGIVST_CAL_TGTREF_PHOT is always analog and only collects NUM -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_TGTREF_PHOT</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>OPEN</value>
    </operand>
    <operator>and</operator>
  </nfov_nc>
  <nfov_pc><!-- sat spots are always analog NUM so no sat spot rule is needed -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>1</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>OPEN</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
  </nfov_pc>
  <pol_a><!-- CGIVST_TDD_POL_OBS has no EXCAM acquisition. NFOV and WFOV
             polarimetry share this channel; they are never presented
             simultaneously. -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_POL_OBS</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>POL0</value>
      <value>POL45</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_POL_OBS</value>
    </operand>
    <operand keyword="SATSPOTS" operator="equals-any">
      <value>True</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>POL0</value>
      <value>POL45</value>
    </operand>
    <operator>and</operator>
    <operator>or</operator>
  </pol_a>
  <pol_pc>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_POL_OBS</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>POL0</value>
      <value>POL45</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>1</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
  </pol_pc>
  <spec_a>
    <operand keyword="VISTYPE" operator="equals-any">
      <!--  <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>  -->
      <value>PAUSED_FOR_REVIEW</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>PRISM2</value>
      <value>PRISM3</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
  </spec_a>
  <spec_nc>
    <operand keyword="VISTYPE" operator="equals-any">
      <!--  <value>CGIVST_CAL_SPEC_TGTREF</value>  -->
      <value>PAUSED_FOR_REVIEW</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>PRISM2</value>
      <value>PRISM3</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FPAMNAME" not="true" operator="contains-any">
      <value>OPEN</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" not="true" operator="equals-any">
      <value>ACQ</value>
      <value>SPBAL-FPAM</value>
      <value>SPBAL-FSAM</value>
    </operand>
    <operator>and</operator>
  </spec_nc>
  <spec_pc>
    <operand keyword="VISTYPE" operator="equals-any">
      <!--  <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>  -->
      <value>PAUSED_FOR_REVIEW</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>PRISM2</value>
      <value>PRISM3</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>1</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
  </spec_pc>
  <wfov_a><!-- same as nfov_a except SPAMNAME -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
    </operand>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>WFOV</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
    </operand>
    <operand keyword="SATSPOTS" operator="equals-any">
      <value>True</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>0</value>
    </operand>
    <operator>and</operator>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>WFOV</value>
    </operand>
    <operator>and</operator>
    <operator>or</operator>
  </wfov_a>
  <wfov_nc><!-- same as nfov_nc except SPAMNAME -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_CAL_TGTREF_PHOT</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>WFOV</value>
    </operand>
    <operator>and</operator>
  </wfov_nc>
  <wfov_pc><!-- same as nfov_pc except SPAMNAME -->
    <operand keyword="VISTYPE" operator="equals-any">
      <value>CGIVST_TDD_OBS</value>
      <value>CGIVST_TDD_SETUP_HOWFSC</value>
      <value>CGIVST_TDD_OBS_HOWFSC</value>
    </operand>
    <operand keyword="DPAMNAME" operator="contains-any">
      <value>IMAGING</value>
    </operand>
    <operator>and</operator>
    <operand keyword="ISPC" operator="contains-any">
      <value>1</value>
    </operand>
    <operator>and</operator>
    <operand keyword="SPAMNAME" operator="contains-any">
      <value>WFOV</value>
    </operand>
    <operator>and</operator>
    <operand keyword="FRMTYPE" operator="equals-any">
      <value>CONT</value>
    </operand>
    <operator>and</operator>
  </wfov_pc>
</channels>
